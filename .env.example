# Runtime. Production requires NODE_ENV=production, APP_ORIGIN, and a
# persistent DATABASE_URL. APP_ENV remains accepted for local compatibility.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=./data/tu-trinh-language.db
APP_ORIGIN=
STATIC_DIR=./dist/client
TRUST_PROXY=false
LOG_LEVEL=info
SESSION_TTL_DAYS=30
DATABASE_BUSY_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
BODY_LIMIT_BYTES=1000000
AUDIO_BODY_LIMIT_BYTES=16000000
RATE_LIMIT_WINDOW_MS=60000
GENERAL_RATE_LIMIT=300
AUTH_RATE_LIMIT=10
PROVIDER_RATE_LIMIT=30
ALLOW_DEMO_SEED=false
BACKUP_DIR=./backups
# Optional: only set to explicitly prune old backups after a successful backup.
BACKUP_RETENTION_COUNT=
# Keep empty for the supported same-origin setup. Set only when the API origin
# is configured to allow the frontend origin.
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://127.0.0.1:3000
# GitHub Pages edition only. The Worker URL is public; never place API secrets in VITE_* values.
VITE_RUNTIME_MODE=server
VITE_PAGES_BASE_PATH=/quizletapp/
VITE_LANGUAGE_API_URL=
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=
PRONUNCIATION_PROVIDER=
PRONUNCIATION_API_KEY=
VOCABULARY_ENRICHMENT_PROVIDER=
VOCABULARY_ENRICHMENT_API_KEY=
